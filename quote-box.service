[Unit]
Description=quote-box quote display app
After=network.target

[Service]
Type=simple
User=quote-box
Group=quote-box
WorkingDirectory=__INSTALL_DIR__
ExecStart=__INSTALL_DIR__/.venv/bin/python -m app
Restart=on-failure
RestartSec=5s
StandardOutput=journal
StandardError=journal
SyslogIdentifier=quote-box

# Hardening — LAN service, no real auth, defense in depth doesn't hurt.
# Note: ProtectHome is deliberately NOT set. Installs under /home/<user>/...
# are common; ProtectHome=yes would make the service unable to see its own
# venv Python. ProtectSystem=strict still keeps everything outside of
# ReadWritePaths read-only, so writes are still scoped.
NoNewPrivileges=yes
PrivateTmp=yes
ProtectSystem=strict
ReadWritePaths=__INSTALL_DIR__/data __INSTALL_DIR__/backups

[Install]
WantedBy=multi-user.target
